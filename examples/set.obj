obj SET is
  pr NAT .
  sort Set .
  subsort Nat < Set .
  op empty : -> Set .
  op _,_ : Set Set -> Set [assoc comm idem id: empty prec 50] .
  op _in_ : Nat Set -> Bool [prec 55] .
  op card : Set -> Nat .
  vars N M : Nat .
  var S : Set .
  eq N in empty = false .
  eq N in (N , S) = true .
  eq N in (M , S) = N == M or N in S .
  eq card(empty) = 0 .
  eq card(N , S) = s card(S) .
endo

red 1 , 2 , 1 , 3 , 2 .
red 3 in (1 , 2 , 3) .
red 4 in (1 , 2 , 3) .
red card(1 , 2 , 2 , 3 , 1) .
